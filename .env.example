# Шаблон змінних оточення. Скопіювати і вписати ключі:
#
#     cp .env.example .env
#
# Усі змінні, крім ключів, мають робочі умовчання — значення нижче
# збігаються з умовчаннями в config.py.

# ── Провайдер моделі ──────────────────────────────────────────────────────────
# ключ основної моделі
ANTHROPIC_API_KEY=sk-ant-...
# ключ резервної моделі
GOOGLE_API_KEY=AIza...
# основний провайдер
LLM_PROVIDER=anthropic
# резервний провайдер
LLM_FALLBACK_PROVIDER=google
# модель Anthropic
ANTHROPIC_MODEL=claude-haiku-4-5
# модель Google
GEMINI_MODEL=gemini-flash-latest
# полегшена модель Google
GEMINI_LITE_MODEL=gemini-flash-lite-latest

# ── Спостережуваність ─────────────────────────────────────────────────────────
# true вмикає трасування; облік токенів працює й без нього
LANGSMITH_TRACING=false
# ключ LangSmith
LANGSMITH_API_KEY=lsv2_pt_...
# проєкт у LangSmith
LANGSMITH_PROJECT=hw3-mas-philosophy
# адреса LangSmith
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# рівень діагностики: DEBUG…CRITICAL
LOG_LEVEL=WARNING

# ── Гроші ─────────────────────────────────────────────────────────────────────
# місячний бюджет на друковані видання
BUDGET_MONTHLY_EUR=60.0
# витрати за одну сесію
SESSION_SPEND_LIMIT_EUR=40.0
# примірників в одному замовленні
MAX_COPIES_PER_ORDER=3

# ── Межі агента і прогону ─────────────────────────────────────────────────────
# кроків одного агента
MAX_STEPS_PER_AGENT=10
# кроків плану
MAX_PLAN_STEPS=8
# передач запиту між ролями
MAX_HOPS=4
# викликів моделі за прогін
MAX_LLM_CALLS_PER_RUN=20
# викликів інструментів за прогін
MAX_TOOL_CALLS_PER_RUN=25
# час одного агента, секунд
AGENT_TIMEOUT_SEC=90.0
# час усього прогону, секунд
RUN_TIMEOUT_SEC=300.0
# однакових викликів поспіль
LOOP_DETECTOR_MAX_REPEATS=3

# ── Рубежі ────────────────────────────────────────────────────────────────────
# довжина запиту, символів
MAX_INPUT_LEN=5000
# довжина відповіді, символів
MAX_OUTPUT_LEN=8000
# розмір відповіді служби, байтів
MAX_TOOL_RESPONSE_BYTES=20000
# запитів у ковзному вікні
RATE_LIMIT_MAX_CALLS=30
# довжина вікна, секунд
RATE_LIMIT_WINDOW_SEC=60.0
# підтверджень людини за сесію
MAX_APPROVALS_PER_SESSION=5
# домени отримувачів листа
MAIL_ALLOWED_DOMAINS=example.com,example.org
# вузли, куди дозволено ходити
EGRESS_ALLOWED_HOSTS=www.wikidata.org,query.wikidata.org,gutendex.com

# ── Шляхи ─────────────────────────────────────────────────────────────────────
# тека стану
STATE_DIR=state
# файл чекпоінтера
DB_PATH=state/agent_state.db
# журнал безпеки
AUDIT_PATH=state/audit.jsonl
# журнал траєкторії
TRAJECTORY_PATH=trajectory.json
# сховище ChromaDB
CHROMA_PATH=chroma_db
# знімок схем служб MCP
MCP_MANIFEST_PATH=mcp_manifest.json

# ── Ціни моделей, доларів за мільйон токенів ──────────────────────────────────
# вхід Anthropic
PRICE_ANTHROPIC_INPUT=1.0
# вихід Anthropic
PRICE_ANTHROPIC_OUTPUT=5.0
# вхід Google
PRICE_GOOGLE_INPUT=0.075
# вихід Google
PRICE_GOOGLE_OUTPUT=0.3

# ── Перевірка атаками через deepteam ──────────────────────────────────────────
# які вразливості перевіряти
DEEPTEAM_VULNERABILITIES=RBAC,BFLA,BOLA,PIILeakage,PromptLeakage,ExcessiveAgency,GoalTheft,SSRF,Misinformation,IntellectualProperty
# які підсилення застосовувати
DEEPTEAM_ENHANCEMENTS=Multilingual,Base64,Roleplay,Crescendo
# атак на кожен тип
DEEPTEAM_ATTACKS_PER_TYPE=1
